# LammpsForcefieldTools / lft global configuration.
#
# Values are plain "key = value" lines; '#' and ';' start comments. Command
# line flags always win over this file, and environment variables always win
# over these tool paths, so nothing here is required for a working install.
#
# Use $LFT_CONFIG to point at a specific file, or copy this file next to the
# package/repository root (the default lookup location). There is no
# per-project configuration lookup.

# --- pipeline defaults (CLI flags override these) ---
# output   = lammps        ; lammps | gromacs
# ff       = gaff+uff      ; gaff | gaff+uff | uff | manual
# charge   = resp          ; resp | resp2 | am1-bcc | mmff94 | cm5 | raw_cm5 | adch | mk | input
# qc       = b3lyp-d3bj/def2-svp

# --- external tool paths (only needed when auto-discovery fails) ---
# gmx        = /usr/local/gromacs/bin/gmx
# lmp        = /path/to/lmp
# moltemplate = /path/to/moltemplate.sh
# obabel     = /path/to/obabel
# atomtype   = /path/to/atomtype
# orca       = /path/to/orca
# param_dir  = /path/to/reference/parameter/dir

# --- optional validation switches ---
# external_atomtype = no
# am1bcc_external   = no
